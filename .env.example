GEMINI_API_KEY=

# SMS OTP delivery (optional). When unset, OTP delivery falls back to a
# development-only mechanism and the OTP is returned as `devOtp` in API
# responses (never in production).
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Development-only: print issued OTPs to the server console.
# Keep off in production. Never enabled there.
DEV_OTP_CONSOLE=false
